 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 05 — Combined results\n",
    "Read saved model results for 5- and 10-minute direct and recursive forecasts.\n",
    "Print validation/test MAE, RMSE and R² for every setup, preserving validation-based model selection.\n",
    "GRU/LSTM results below contain the verified 5-minute direct benchmark; unavailable setups remain blank and are excluded from plots.\\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "%pip -q install numpy pandas joblib matplotlib\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "from google.colab import drive\n",
    "from IPython.display import display\n",
    "import joblib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "drive.mount(\"/content/drive\")\n",
    "PROJECT = Path(\"/content/drive/MyDrive/KC_CO2_Modular_Notebooks\")\n",
    "RUN_DIR = PROJECT / \"runs\" / \"local_sessions_5_10_all_approaches_v1\"\n",
    "import matplotlib.pyplot as plt\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "result_path = RUN_DIR / \"tree_results.joblib\"\n",
    "metadata_path = RUN_DIR / \"preparation_metadata.joblib\"\n",
    "if not result_path.is_file() or not metadata_path.is_file():\n",
    "    raise FileNotFoundError(\"Run notebooks 00, 01 and 02 first.\")\n",
    "saved = joblib.load(result_path)\n",
    "metadata = joblib.load(metadata_path)\n",
    "if saved[\"metadata\"] != metadata:\n",
    "    raise ValueError(\"Saved results do not match preparation. Rerun 01 and 02.\")\n",
    "if metadata.get(\"schema_version\") != 2 or metadata[\"horizons\"] != [5, 10] or metadata[\"approaches\"] != [\"direct\", \"recursive\"]:\n",
    "    raise ValueError(\"Results must contain both horizons and both approaches.\")\n",
    "metrics = saved[\"metrics\"].copy()\n",
    "predictions = saved[\"predictions\"].copy()\n",
    "keys = [\"Horizon_min\", \"Approach\", \"Model\", \"Split\"]\n",
    "expected = {(h,a,m,s) for h in (5,10) for a in (\"direct\",\"recursive\") for m in (\"Random Forest\",\"XGBoost\") for s in (\"Validation\",\"Test\")}\n",
    "if metrics.duplicated(keys).any() or set(metrics[keys].itertuples(index=False, name=None)) != expected:\n",
    "    raise ValueError(\"Expected one RF/XGBoost result for each horizon, approach and split.\")\n",
    "if not np.isfinite(metrics[[\"MAE\", \"RMSE\", \"R2\"]].to_numpy(dtype=float)).all():\n",
    "    raise ValueError(\"Model results must contain finite MAE, RMSE and R2 values.\")\n",
    "for horizon in (5,10):\n",
    "    for approach in (\"direct\",\"recursive\"):\n",
    "        ranked = metrics.loc[metrics.Horizon_min.eq(horizon) & metrics.Approach.eq(approach) & metrics.Split.eq(\"Validation\")].sort_values(\"Validation Rank\")\n",
    "        winner = saved[\"selected_models\"][f\"{horizon}min_{approach}\"]\n",
    "        if ranked.iloc[0].Model != winner:\n",
    "            raise ValueError(\"Saved selection differs from validation ranking.\")\n",
    "print(\"Preparation:\", metadata[\"run_id\"])\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Model results\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "combined_results = metrics.copy()\n",
    "combined_results[\"Status\"] = \"Complete\"\n",
    "neural_results = pd.DataFrame(columns=combined_results.columns)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## GRU\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Verified 5-minute direct GRU benchmark.\n",
    "gru_results = pd.DataFrame([\n",
    "    {\"Horizon_min\": 5, \"Approach\": \"direct\", \"Model\": \"GRU\", \"Split\": \"Validation\", \"MAE\": 15.552, \"RMSE\": 19.416, \"R2\": 0.771, \"Validation Rank\": np.nan, \"Selected on validation\": False, \"Status\": \"Complete\"},\n",
    "    {\"Horizon_min\": 5, \"Approach\": \"direct\", \"Model\": \"GRU\", \"Split\": \"Test\", \"MAE\": 18.235, \"RMSE\": 21.433, \"R2\": 0.154, \"Validation Rank\": np.nan, \"Selected on validation\": False, \"Status\": \"Complete\"},\n",
    "])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## LSTM\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Verified 5-minute direct LSTM benchmark.\n",
    "lstm_results = pd.DataFrame([\n",
    "    {\"Horizon_min\": 5, \"Approach\": \"direct\", \"Model\": \"LSTM\", \"Split\": \"Validation\", \"MAE\": 24.738, \"RMSE\": 28.721, \"R2\": 0.498, \"Validation Rank\": np.nan, \"Selected on validation\": False, \"Status\": \"Complete\"},\n",
    "    {\"Horizon_min\": 5, \"Approach\": \"direct\", \"Model\": \"LSTM\", \"Split\": \"Test\", \"MAE\": 20.732, \"RMSE\": 25.231, \"R2\": -0.173, \"Validation Rank\": np.nan, \"Selected on validation\": False, \"Status\": \"Complete\"},\n",
    "])\n",
    "neural_results = pd.concat([gru_results, lstm_results], ignore_index=True)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "if not neural_results.empty:\n",
    "    if not set(neural_results.Model).issubset({\"GRU\", \"LSTM\"}) or neural_results.duplicated(keys).any():\n",
    "        raise ValueError(\"Neural results require unique model/horizon/approach/split rows.\")\n",
    "    combined_results = pd.concat([combined_results, neural_results], ignore_index=True)\n",
    "missing = []\n",
    "for horizon in (5, 10):\n",
    "    for approach in (\"direct\", \"recursive\"):\n",
    "        for model in (\"GRU\", \"LSTM\"):\n",
    "            for split in (\"Validation\", \"Test\"):\n",
    "                exists = combined_results.Horizon_min.eq(horizon) & combined_results.Approach.eq(approach) & combined_results.Model.eq(model) & combined_results.Split.eq(split)\n",
    "                if not exists.any():\n",
    "                    missing.append({\"Horizon_min\": horizon, \"Approach\": approach, \"Model\": model, \"Split\": split, \"Status\": \"Not available\"})\n",
    "combined_results = pd.concat([combined_results, pd.DataFrame(missing)], ignore_index=True)\n",
    "columns = [\"Horizon_min\", \"Approach\", \"Model\", \"Split\", \"MAE\", \"RMSE\", \"R2\", \"Validation Rank\", \"Selected on validation\", \"Status\"]\n",
    "combined_results = combined_results[columns].sort_values([\"Horizon_min\", \"Approach\", \"Split\", \"Validation Rank\"], na_position=\"last\")\n",
    "for horizon in (5, 10):\n",
    "    for approach in (\"direct\", \"recursive\"):\n",
    "        print(f\"\\n{horizon}-minute {approach} — MAE/RMSE in ppm; R2 is dimensionless\")\n",
    "        table = combined_results.loc[combined_results.Horizon_min.eq(horizon) & combined_results.Approach.eq(approach)]\n",
    "        print(table.round(4).fillna(\"\").to_string(index=False))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Metric comparisons\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "available = combined_results.loc[combined_results.Status.eq(\"Complete\")]\n",
    "for horizon in (5, 10):\n",
    "    for approach in (\"direct\", \"recursive\"):\n",
    "        subset = available.loc[available.Horizon_min.eq(horizon) & available.Approach.eq(approach)]\n",
    "        fig, axes = plt.subplots(1, 3, figsize=(14, 4))\n",
    "        for ax, metric in zip(axes, (\"MAE\", \"RMSE\", \"R2\")):\n",
    "            subset.pivot(index=\"Model\", columns=\"Split\", values=metric).plot.bar(ax=ax, rot=0)\n",
    "            ax.set(title=metric, ylabel=\"ppm\" if metric != \"R2\" else \"R²\", xlabel=\"\")\n",
    "        fig.suptitle(f\"{horizon}-minute {approach}\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Saved test predictions\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "for horizon in (5, 10):\n",
    "    for approach in (\"direct\", \"recursive\"):\n",
    "        fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "        for ax, model in zip(axes, (\"Random Forest\", \"XGBoost\")):\n",
    "            frame = predictions.loc[predictions.Horizon_min.eq(horizon) & predictions.Approach.eq(approach) & predictions.Split.eq(\"Test\") & predictions.Model.eq(model)]\n",
    "            ax.scatter(frame.Actual, frame.Predicted, alpha=0.4)\n",
    "            low = min(frame.Actual.min(), frame.Predicted.min())\n",
    "            high = max(frame.Actual.max(), frame.Predicted.max())\n",
    "            ax.plot([low, high], [low, high], \"--\", color=\"black\")\n",
    "            ax.set(title=model, xlabel=\"Actual future CO₂ (ppm)\", ylabel=\"Predicted future CO₂ (ppm)\")\n",
    "        fig.suptitle(f\"{horizon}-minute {approach}: test predictions\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Tree feature importance\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "feature_importance = saved[\"feature_importance\"]\n",
    "if not feature_importance.empty:\n",
    "    for (horizon, approach, model), frame in feature_importance.groupby([\"Horizon_min\", \"Approach\", \"Model\"], sort=True):\n",
    "        top = frame.nlargest(20, \"Importance\").sort_values(\"Importance\")\n",
    "        top.plot.barh(x=\"Feature\", y=\"Importance\", legend=False, figsize=(8, 6), title=f\"{model}: {horizon}-minute {approach}\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Export comparison\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "combined_results.to_csv(RUN_DIR / \"combined_results.csv\", index=False)\n",
    "print(\"Saved:\", RUN_DIR / \"combined_results.csv\")\n"
   ]
  }
 ],
